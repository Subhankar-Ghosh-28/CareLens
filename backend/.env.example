# CareLens Backend Environment Configuration Template
# Copy this file to .env and configure your local credentials.
# NEVER commit the actual .env file to git.

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/carelens_db

# Local Tesseract OCR Path (Optional override if not in system PATH)
# Windows default example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example:
# TESSERACT_CMD=/usr/bin/tesseract

# Server Configuration
HOST=127.0.0.1 
PORT=8000
ENVIRONMENT=development
